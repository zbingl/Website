{
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": [
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "deno.ns"
    ],
    "types": [
      "npm:vitest/globals",
      "npm:@testing-library/jest-dom"
    ]
  },
  "tasks": {
    "dev": "deno run -A npm:vite ",
    "build": "deno task check:all && deno run -A npm:vite build",
    "build:no-check": "deno run -A npm:vite build",
    "preview": "deno run -A npm:vite preview",
    "test": "deno run -A npm:vitest",
    "check:all": "deno fmt --check && deno lint && deno check && deno task test run",
    "fix": "deno fmt && deno lint --fix",
    "clean": "rm -rf dist/",
    "fresh": "rm -rf .vite/ node_modules/ dist/ && deno install"
  },
  "imports": {
    "@/": "./src/",
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^1.0.6",
    "@std/assert": "jsr:@std/assert@1",
    "@tailwindcss/typography": "npm:@tailwindcss/typography@^0.5.19",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.1.18",
    "@testing-library/jest-dom": "npm:@testing-library/jest-dom@^6.9.1",
    "@testing-library/react": "npm:@testing-library/react@^16.3.2",
    "@types/react": "npm:@types/react@^19.2.9",
    "@types/react-dom": "npm:@types/react-dom@^19.2.3",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^5.1.2",
    "daisyui": "npm:daisyui@^5.5.18",
    "happy-dom": "npm:happy-dom@^20.3.4",
    "react": "npm:react@^19.2.3",
    "react-dom": "npm:react-dom@^19.2.3",
    "react-markdown": "npm:react-markdown@^10.1.0",
    "react-router-dom": "npm:react-router-dom@^7.12.0",
    "tailwindcss": "npm:tailwindcss@^4.1.18",
    "vite": "npm:vite@^7.3.1",
    "vitest": "npm:vitest@^4.0.17"
  },
  "format": {
    "useTabs": false,
    "lineWidth": 120,
    "indentWidth": 2,
    "singleQuote": false
  },
  "exclude": [
    "deno.lock",
    "node_modules",
    "dist",
    ".vite"
  ]
}
